import java.util.Date;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;

-- Extract chapters modified since given epoch seconds, joined with parent manga identity
getModifiedChapters:
SELECT
    C._id AS chapterId,
    M.source AS mangaSource,
    M.url AS mangaUrl,
    C.url AS chapterUrl,
    C.name AS chapterName,
    C.read,
    C.bookmark,
    C.last_page_read AS lastPageRead,
    C.chapter_number AS chapterNumber,
    C.scanlator,
    C.last_modified_at AS lastModifiedAt,
    C.version
FROM chapters C
JOIN mangas M ON C.manga_id = M._id
WHERE (:sinceSeconds = 0 AND (C.read = 1 OR C.last_page_read > 0 OR C.bookmark = 1))
   OR (:sinceSeconds > 0 AND (C.is_dirty = 1 OR C.last_modified_at >= :sinceSeconds));

-- Extract history records modified since given Date/millis, joined with manga & chapter identity
getModifiedHistory:
SELECT
    H._id AS historyId,
    M.source AS mangaSource,
    M.url AS mangaUrl,
    C.url AS chapterUrl,
    H.last_read AS lastRead,
    H.time_read AS timeRead
FROM history H
JOIN chapters C ON H.chapter_id = C._id
JOIN mangas M ON C.manga_id = M._id
WHERE (:sinceMillis = 0 AND H.last_read > 0)
   OR (:sinceMillis > 0 AND (H.is_dirty = 1 OR H.last_read > :sinceMillis));

-- Extract favorite mangas modified since given epoch seconds
getModifiedMangas:
SELECT
    M._id AS mangaId,
    M.source,
    M.url,
    M.title,
    M.artist,
    M.author,
    M.description,
    M.genre,
    M.status,
    M.thumbnail_url AS thumbnailUrl,
    M.favorite,
    M.chapter_flags AS chapterFlags,
    M.viewer AS viewerFlags,
    M.date_added AS dateAdded,
    M.last_modified_at AS lastModifiedAt,
    M.favorite_modified_at AS favoriteModifiedAt,
    M.version
FROM mangas M
WHERE (:sinceSeconds = 0 AND M.favorite = 1)
   OR (:sinceSeconds > 0 AND (M.is_dirty = 1 OR M.last_modified_at >= :sinceSeconds OR (M.favorite_modified_at IS NOT NULL AND M.favorite_modified_at >= :sinceSeconds)));

-- Extract categories associated with a manga
getCategoriesForManga:
SELECT
    C.name,
    C.sort AS `order`,
    C.flags
FROM categories C
JOIN mangas_categories MC ON C._id = MC.category_id
WHERE MC.manga_id = :mangaId;

-- Helper to find local manga by natural key
getMangaBySourceAndUrl:
SELECT *
FROM mangas
WHERE source = :source AND url = :url
LIMIT 1;

-- Helper to find local chapter by parent manga ID and chapter URL
getChapterByMangaIdAndUrl:
SELECT *
FROM chapters
WHERE manga_id = :mangaId AND url = :chapterUrl
LIMIT 1;

-- Helper to find category by name
getCategoryByName:
SELECT *
FROM categories
WHERE name = :name
LIMIT 1;

-- Extract all user categories
getAllCategories:
SELECT
    _id AS id,
    name,
    sort AS `order`,
    flags
FROM categories
WHERE _id > 0;

-- Helper to insert category
insertCategory:
INSERT INTO categories(name, sort, flags)
VALUES (:name, :order, :flags)
RETURNING _id;

-- Helper to update category order and flags
updateCategory:
UPDATE categories
SET sort = :order, flags = :flags
WHERE _id = :id;

-- Helper to associate manga with category
insertMangaCategory:
INSERT OR IGNORE INTO mangas_categories(manga_id, category_id)
VALUES (:mangaId, :categoryId);

-- Helper to remove all category associations for a manga
deleteMangaCategoriesForManga:
DELETE FROM mangas_categories
WHERE manga_id = :mangaId;

-- Upsert a remote reading history record with is_dirty = 0
upsertSyncHistory:
INSERT INTO history(chapter_id, last_read, time_read, is_dirty)
VALUES (:chapterId, :readAt, :time_read, 0)
ON CONFLICT(chapter_id)
DO UPDATE
SET
    last_read = :readAt,
    time_read = time_read + :time_read,
    is_dirty = 0
WHERE chapter_id = :chapterId;

-- Insert a remote manga with is_syncing = 1 and is_dirty = 0
insertSyncManga:
INSERT INTO mangas(
    source, url, artist, author, description, genre, title, status, thumbnail_url, favorite,
    last_update, next_update, initialized, viewer, chapter_flags, cover_last_modified, date_added,
    update_strategy, calculate_interval, last_modified_at, favorite_modified_at, version, is_syncing, is_dirty
)
VALUES (
    :source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, :favorite,
    0, 0, 0, :viewerFlags, :chapterFlags, 0, :dateAdded,
    0, 0, :lastModifiedAt, :favoriteModifiedAt, :version, 1, 0
)
RETURNING _id;

-- Insert a remote chapter with is_syncing = 1 and is_dirty = 0
insertSyncChapter:
INSERT INTO chapters(
    manga_id, url, name, scanlator, read, bookmark, last_page_read,
    chapter_number, source_order, date_fetch, date_upload,
    last_modified_at, version, is_syncing, is_dirty
)
VALUES (
    :mangaId, :url, :name, :scanlator, :read, :bookmark, :lastPageRead,
    :chapterNumber, 0, 0, 0,
    :lastModifiedAt, :version, 1, 0
)
RETURNING _id;

-- Set is_syncing flag on specific chapter
setChapterIsSyncing:
UPDATE chapters
SET is_syncing = :isSyncing
WHERE _id = :chapterId;

-- Set is_syncing flag on specific manga
setMangaIsSyncing:
UPDATE mangas
SET is_syncing = :isSyncing
WHERE _id = :mangaId;

-- Reset is_syncing on all chapters
resetAllChapterIsSyncing:
UPDATE chapters
SET is_syncing = 0
WHERE is_syncing != 0;

-- Reset is_syncing on all mangas
resetAllMangaIsSyncing:
UPDATE mangas
SET is_syncing = 0
WHERE is_syncing != 0;

-- Clear dirty flags on specific chapters
clearDirtyChaptersByIds:
UPDATE chapters
SET is_dirty = 0
WHERE _id IN :chapterIds;

-- Clear dirty flags on specific mangas
clearDirtyMangasByIds:
UPDATE mangas
SET is_dirty = 0
WHERE _id IN :mangaIds;

-- Clear dirty flags on specific history records
clearDirtyHistoryByIds:
UPDATE history
SET is_dirty = 0
WHERE _id IN :historyIds;

